# Copy to .env (the generator does this for you on first run).
# Environment variables always win over values in this file.

ENVIRONMENT=local
DEBUG=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Optional: point the test suite at a different database.
# Defaults to the same server with a "_test" suffix on the database name.
# TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/app_test
